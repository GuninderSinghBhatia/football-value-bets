# Copy to .env.local and fill in. .env.local is gitignored, never commit real keys.

# The Odds API key (https://the-odds-api.com). Adds Pinnacle, Bet365-style EU/UK books etc. next to DraftKings.
ODDS_API_KEY=your-odds-api-key

# Bookmaker regions to fetch: uk, eu, us, us2, au (comma-separated). Each region multiplies quota cost.
ODDS_API_REGIONS=eu,uk

# How long odds are cached in memory before refetching. One full refresh with the defaults costs 24 credits.
ODDS_API_CACHE_MINUTES=60

# Optional: protects POST /api/jobs/settle (send as "Authorization: Bearer <secret>").
CRON_SECRET=
